<Window x:Class="ZapretDPI.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giriş" Height="250" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Montserrat, Arial">

    <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1" CornerRadius="12" Padding="0" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" CornerRadius="11,11,0,0" Padding="16,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblTitle" Text="Giriş" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="26" Height="26" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#DC2626" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,16,22,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblMessage" Grid.Row="0" Text="Değer giriniz:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />
                <TextBox x:Name="TxtInput" Grid.Row="1" Height="36" Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,0" VerticalContentAlignment="Center" FontSize="12" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" CornerRadius="0,0,11,11" Padding="18,14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="İptal" MinWidth="95" Height="36" Padding="16,0" Style="{StaticResource ModernButton}" Click="BtnCancel_Click" Margin="0,0,10,0" />
                    <Button x:Name="BtnOk" Content="Tamam" MinWidth="95" Height="36" Padding="16,0" Style="{StaticResource PrimaryButton}" Click="BtnOk_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
