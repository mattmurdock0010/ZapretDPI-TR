<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <StartupObject>ZapretDPI.Program</StartupObject>
    <AssemblyName>ZapretDPI-TR</AssemblyName>
    <AssemblyTitle>ZapretDPI-TR</AssemblyTitle>
    <Product>ZapretDPI-TR</Product>
    <RootNamespace>ZapretDPI</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>Matt Murdock</Authors>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Description>Türkiye ISS'leri için optimize edilmiş modern Windows DPI Bypass &amp; Şifreli DNS Aracı</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" Condition="Exists('icon.ico')" />
    <None Include="..\bin\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="bin" />
    <None Include="..\config\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="config" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="MdXaml" Version="1.27.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
