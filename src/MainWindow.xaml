<Window x:Class="ZapretDPI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="ZapretDPI-TR" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{StaticResource BgDarkBrush}"
        FontFamily="{StaticResource AppFont}"
        Icon="icon.ico">

    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{StaticResource BgDarkBrush}">
        <Grid>
            <Grid.RowDefinitions>
                
                <RowDefinition Height="46" />
                
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

<Border Grid.Row="0" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <Image Source="icon.ico" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="ZapretDPI-TR" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding IsTrafficActive, Converter={StaticResource BooleanToTrafficColorConverter}}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTrafficActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="PulseStoryboard">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:1" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseStoryboard" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding TrafficInfo}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        
                        <ComboBox x:Name="CmbLanguage" Width="110" Height="28" SelectionChanged="CmbLanguage_SelectionChanged" Margin="0,0,10,0">
                            <ComboBoxItem Tag="tr">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#DC2626" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                        <TextBlock Text="TR" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="Türkçe" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="en">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#2563EB" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                        <TextBlock Text="EN" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="English" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="ru">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#475569" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                        <TextBlock Text="RU" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="Русский" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

<Button Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click" Content="—" FontSize="13" />
                        
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" Content="✕" FontSize="14" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

<Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    
                    <ColumnDefinition Width="200" />
                    
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

<Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

<StackPanel Grid.Row="0" Margin="10,16,10,10">
                            <RadioButton x:Name="NavOverview" Content="Genel Bakış" IsChecked="True" Tag="Overview" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" />
                            <RadioButton x:Name="NavRules" Content="Paket Kuralları" Tag="Rules" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" Margin="0,4,0,0" />
                            <RadioButton x:Name="NavFilters" Content="Filtreler &amp; Domainler" Tag="Filters" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" Margin="0,4,0,0" />
                            <RadioButton x:Name="NavDns" Content="DNS &amp; DoH" Tag="Dns" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" Margin="0,4,0,0" />
                            <RadioButton x:Name="NavLan" Content="Ağ Paylaşımı" Tag="Lan" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" Margin="0,4,0,0" />
                            <RadioButton x:Name="NavAnalysis" Content="ISS Analizi" Tag="Analysis" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" Margin="0,4,0,0" />
                            <RadioButton x:Name="NavConsole" Content="Konsol &amp; Loglar" Tag="Console" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" Margin="0,4,0,0" />
                            <RadioButton x:Name="NavRecovery" Content="Kurtarma" Tag="Recovery" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" Margin="0,4,0,0" />
                            <RadioButton x:Name="NavAbout" Content="Hakkında" Tag="About" Click="NavButton_Click" Style="{StaticResource SidebarRadioStyle}" Margin="0,4,0,0" />
                        </StackPanel>

<Border Grid.Row="1" Margin="14,0,14,14" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock x:Name="LblFooterVersionHeader" Text="Yazılım Sürümü" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtFooterVersionValue" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

<Border Grid.Column="1" Background="{StaticResource BgDarkBrush}" Padding="20,18">
                    <Grid>

<ScrollViewer x:Name="PageOverview" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="LblOverviewTitle" Text="Genel Bakış" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="TxtDashboardSubtitle" Text="ZapretDPI-TR hazır • Başlatmaya hazır" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" />

<Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>

<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,10">
                                            <TextBlock x:Name="LblPillRouting" Text="Etkin yönlendirme" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="DotRouting" Width="7" Height="7" Fill="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtRoutingStatus" Text="Kurulmamış" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,10">
                                            <TextBlock x:Name="LblPillEngine" Text="DPI yöntemi" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="DotEngine" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtEngineStatus" Text="Zapret2 (LUA)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

<StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock x:Name="LblPillService" Text="Çalışan servis" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="DotService" Width="7" Height="7" Fill="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtServiceStatus" Text="0 servis" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

<StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock x:Name="LblPillDns" Text="DNS / DoH" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="DotDns" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtDnsStatus" Text="Cloudflare (1.1.1.1)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock x:Name="LblPillWinDivert" Text="WinDivert bileşeni" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="DotWinDivert" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtWinDivertStatus" Text="Yüklü (v1.0.4)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>

<StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">
                                            <TextBlock x:Name="LblPillLan" Text="Ağ Paylaşımı" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Ellipse x:Name="DotLan" Width="7" Height="7" Fill="#6B7280" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtLanStatus" Text="Kapalı" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

<Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <emoji:TextBlock Text="🎯" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <TextBlock x:Name="LblOverviewActiveProfileTitle" Text="Kullanılacak DPI Profili" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="LblOverviewActiveProfileDesc" Text="Standart başlatma ve Windows Servisi bu seçili stratejiyle çalışır." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="20,2,0,0" />
                                        </StackPanel>

                                        <ComboBox x:Name="CmbOverviewStrategy" Grid.Column="1" Height="36" SelectionChanged="CmbOverviewStrategy_SelectionChanged" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>

<Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="LblActionSectionTitle" Text="Yönlendirme Kurulumu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="LblActionSectionDesc" Text="Zapret'in kullandığı Windows yönlendirme ve DPI bypass bileşenlerini başlatır veya kurar." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,10" />

<StackPanel>
                                            
                                            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="180" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="LblQuickStartTitle" Text="Standart Başlatma" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock x:Name="LblQuickStartDesc" Text="Seçili strateji profili ile DPI bypass oturumunu başlatır." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button x:Name="BtnQuickStart" Grid.Column="1" Content="Yükleniyor..." IsEnabled="False" Style="{StaticResource PrimaryButton}" Click="BtnQuickStart_Click" Width="170" Height="36" Padding="0,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

<Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="180" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="LblQuickServiceTitle" Text="Windows Servisi (Otomatik Başlat)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock x:Name="LblQuickServiceDesc" Text="Windows ile birlikte arka planda sessizce otomatik çalışan sistem servisi." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button x:Name="BtnQuickService" Grid.Column="1" Content="Yükleniyor..." IsEnabled="False" Style="{StaticResource ModernButton}" Click="BtnQuickService_Click" Width="170" Height="36" Padding="0,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>

<Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="180" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock x:Name="LblQuickDnscryptTitle" Text="Şifreli DNS (DNSCrypt-proxy)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock x:Name="LblQuickDnscryptDesc" Text="ISS kaynaklı DNS zehirlenmesine karşı şifreli DNS servisini kurar." FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button x:Name="BtnQuickDnscrypt" Grid.Column="1" Content="Yükleniyor..." IsEnabled="False" Style="{StaticResource ModernButton}" Click="BtnQuickDnscrypt_Click" Width="170" Height="36" Padding="0,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

<ScrollViewer x:Name="PageRules" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="LblRulesTitle" Text="Paket Kuralları &amp; Strateji" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="LblRulesDesc" Text="Türkiye'deki ISS'ler için test edilmiş hazır stratejileri veya özel LUA desync parametrelerini seçin." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" />

<Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="LblFilterMode" Text="Filtreleme Modu" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                        <ComboBox x:Name="CmbFilterMode" Height="34" Style="{StaticResource DarkComboBox}" SelectionChanged="CmbFilterMode_SelectionChanged">
                                            <ComboBoxItem x:Name="CmbFilterOff" Content="Kapalı (Tüm internet trafiğine uygula)" />
                                            <ComboBoxItem x:Name="CmbFilterAuto" Content="Auto (Zapret dinamik autohostlist oluşturur)" />
                                            <ComboBoxItem x:Name="CmbFilterManual" Content="Manuel ('hostlist.txt' içindeki domainler)" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>

<Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel>
                                        <TextBlock x:Name="LblPresetTitle" Text="Hazır Strateji Profili" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="CmbStrategyPreset" Height="34" Style="{StaticResource DarkComboBox}" Margin="0,0,0,16" />

                                        <TextBlock x:Name="LblActiveParams" Text="Aktif LUA Parametreleri:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="TxtStrategyParams" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="{StaticResource SidebarBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource CardBorderBrush}" Padding="8" FontFamily="Consolas" Margin="0,0,0,12" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button x:Name="BtnSaveStrategy" Content="Stratejiyi Kaydet" Style="{StaticResource PrimaryButton}" Click="BtnSaveStrategy_Click" Margin="0,0,10,0" Width="135" />
                                            <Button x:Name="BtnDeleteStrategy" Content="Profili Sil" Style="{StaticResource DangerButton}" Click="BtnDeleteStrategy_Click" Margin="0,0,10,0" Width="135" />
                                            <Button x:Name="BtnRestoreDefaults" Content="Varsayılanlar" Style="{StaticResource ModernButton}" Click="BtnRestoreDefaults_Click" Width="120" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

<ScrollViewer x:Name="PageFilters" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="LblFiltersTitle" Text="Filtreler &amp; Domain Listeleri" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="LblFiltersDesc" Text="Bypass uygulanacak ve hariç tutulacak alan adlarını düzenleyin." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

<Border Grid.Column="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LblHostlistTitle" Text="DPI Uygulanacak Domainler" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                            <TextBox x:Name="TxtHostlist" Height="220" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="{StaticResource SidebarBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource CardBorderBrush}" Padding="8" FontFamily="Consolas" Margin="0,0,0,10" />
                                            <Button x:Name="BtnSaveHostlist" Content="Listeyi Kaydet" Style="{StaticResource ModernButton}" Click="BtnSaveHostlist_Click" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>

<Border Grid.Column="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LblExcludelistTitle" Text="Hariç Tutulacak Domainler" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                            <TextBox x:Name="TxtExcludelist" Height="220" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="{StaticResource SidebarBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource CardBorderBrush}" Padding="8" FontFamily="Consolas" Margin="0,0,0,10" />
                                            <Button x:Name="BtnSaveExcludelist" Content="Hariç Listesini Kaydet" Style="{StaticResource ModernButton}" Click="BtnSaveExcludelist_Click" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

<ScrollViewer x:Name="PageDns" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="LblDnsTitle" Text="DNS Yapılandırması &amp; Güvenlik" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock x:Name="LblDnsDesc" Text="DNS zehirlenmesini tespit edin, Google DoH veya DNSCrypt-proxy ile şifreleyin." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" />

<Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="LblPoisonCheckTitle" Text="DNS Zehirlenmesi Kontrolü" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock x:Name="LblPoisonCheckDesc" Text="ISS'nin Discord ve engelli sitelerin IP adreslerini sahte yönlendirmelere yönlendirip yönlendirmediğini test eder." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" />
                                        <Button x:Name="BtnTestDnsPoison" Style="{StaticResource PrimaryButton}" Click="BtnTestDnsPoison_Click" HorizontalAlignment="Left" Padding="16,8">
                                            <StackPanel Orientation="Horizontal">
                                                <emoji:TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtTestDnsPoison" Text="DNS Zehirlenmesini Şimdi Test Et" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock x:Name="LblDnscryptServerTitle" Text="Şifreli DNS Sunucusu (DNSCrypt)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
