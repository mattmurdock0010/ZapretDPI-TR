<Window x:Class="ZapretDPI.ProfileSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strateji Profilini Kaydet" Height="520" Width="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI, Montserrat, Arial">

    <Border Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource AccentBlueBrush}" BorderThickness="1" CornerRadius="12" Padding="0" Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

<Border Grid.Row="0" Background="{StaticResource CardBgBrush}" CornerRadius="11,11,0,0" Padding="16,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentBlueBrush}" Margin="0,0,10,0">
                            <TextBlock Text="★" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <TextBlock x:Name="LblTitle" Text="Çalışan Stratejiyi Kaydet" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="26" Height="26" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="b" Property="Background" Value="#DC2626" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

<Grid Grid.Row="1" Margin="22,16,22,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblDesc" Grid.Row="0" Text="İnternet Servis Sağlayıcınızda başarıyla test edilmiş DPI bypass stratejisi bulundu. Bu stratejiyi kaydederek tek tıkla kullanabilirsiniz." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12" />

<ListBox x:Name="LstStrategies" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,12">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                                <Setter TargetName="itemBorder" Property="Background" Value="#172236" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="#475569" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="✓ ÇALIŞAN STRATEJİ" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                        </Border>
                                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="Zapret2 LUA" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas, Cascadia Code, Courier New" Foreground="#F3F4F6" LineHeight="16" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="📋 Kopyala" ToolTip="Komutu Kopyala" Style="{StaticResource ModernButton}" Padding="8,4" Height="28" FontSize="11" VerticalAlignment="Top" Click="BtnCopyStrategy_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

<TextBlock x:Name="LblName" Grid.Row="2" Text="Profil İsmi:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="TxtProfileName" Grid.Row="3" Height="36" Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,0" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,0,10" />

<CheckBox x:Name="ChkApplyImmediately" Grid.Row="4" Content="Bu stratejiyi varsayılan yap ve hemen Zapret'i başlat" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalContentAlignment="Center" Cursor="Hand" />
            </Grid>

<Border Grid.Row="2" Background="{StaticResource SidebarBrush}" CornerRadius="0,0,11,11" Padding="18,14" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="İptal" MinWidth="95" Height="36" Padding="16,0" Style="{StaticResource ModernButton}" Click="BtnCancel_Click" Margin="0,0,10,0" />
                    <Button x:Name="BtnSave" Content="Kaydet ve Etkinleştir" MinWidth="160" Height="36" Padding="16,0" Style="{StaticResource PrimaryButton}" Click="BtnSave_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
